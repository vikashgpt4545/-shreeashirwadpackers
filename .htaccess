# ----------------------------------------------------------------------
# Shree Ashirwad Packers and Movers - Apache Configuration
# Pure Core PHP URL Routing & Technical SEO Optimization
# ----------------------------------------------------------------------

Options -Indexes
RewriteEngine On

# Canonical Redirects for Production (Force HTTPS and www)
RewriteCond %{HTTP_HOST} ^shreeashirwadpackers\.com$ [NC]
RewriteRule ^(.*)$ https://www.shreeashirwadpackers.com/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.shreeashirwadpackers\.com$ [NC]
RewriteRule ^(.*)$ https://www.shreeashirwadpackers.com/$1 [R=301,L]

# Enforce UTF-8 Encoding
AddDefaultCharset UTF-8

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Gzip / Brotli Compression for Core Web Vitals
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Block direct HTTP access to sensitive JSON files (protects lead backups)
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>

# 301 Permanent Redirects for 9 Core Services to Canonical Trailing Slash
RewriteRule ^(residential-shifting|business-shifting|vehicle-shifting|packing-and-unpacking|loading-and-unloading-services|warehouse-service|international-service|domestics-service|insurance-service)(/index)?(\.php)?$ /$1/ [R=301,L]

# 301 Permanent Redirects to Rescue Historical Backlinks from External Domains
RewriteRule ^packers-and-movers-in-dhanbad-for-home-and-vehicles-move(\.php)?/?$ /packers-and-movers-in-dhanbad [R=301,L]
RewriteRule ^hire-packers-and-movers-in-jamshedpur-jharkhand(\.php)?/?$ /packers-and-movers-in-jamshedpur [R=301,L]
RewriteRule ^packers-and-movers-in-bundu-ranchi(\.php)?/?$ /packers-and-movers-in-bundu [R=301,L]
RewriteRule ^packers-and-movers-in-chanho-ranchi(\.php)?/?$ /packers-and-movers-in-chanho [R=301,L]
RewriteRule ^packers-and-movers-in-kanke-ranchi(\.php)?/?$ /packers-and-movers-in-kanke [R=301,L]
RewriteRule ^packers-and-movers-in-lapung-ranchi(\.php)?/?$ /packers-and-movers-in-lapung [R=301,L]
RewriteRule ^packers-and-movers-in-mandar-ranchi(\.php)?/?$ /packers-and-movers-in-mandar [R=301,L]
RewriteRule ^packers-and-movers-in-namkum-ranchi(\.php)?/?$ /packers-and-movers-in-namkum [R=301,L]
RewriteRule ^packers-and-movers-in-ormanjhi-ranchi(\.php)?/?$ /packers-and-movers-in-ormanjhi [R=301,L]
RewriteRule ^packers-and-movers-in-ratu-ranchi.*$ /packers-and-movers-in-ratu [R=301,L]
RewriteRule ^packers-and-movers-in-silli-ranchi(\.php)?/?$ /packers-and-movers-in-silli [R=301,L]
RewriteRule ^packers-and-movers-in-sonahatu-ranchi(\.php)?/?$ /packers-and-movers-in-sonahatu [R=301,L]
RewriteRule ^packers-and-movers-in-(burmu|khalari|nagri|rahe)-ranchi(\.php)?/?$ / [R=301,L]

# 301 Permanent Redirects for Ranchi Head-Term Duplicate Slugs to Homepage Authority
RewriteRule ^packers-and-movers-in-ranchi-jharkhand(\.php)?/?$ / [R=301,L]
RewriteRule ^professional-packers-and-movers-in-ranchi(\.php)?/?$ / [R=301,L]
RewriteRule ^packers-and-movers-in-ranchi(\.php)?/?$ / [R=301,L]

# 301 Permanent Redirects for Duplicate Spelling Slugs and Regional Slugs
RewriteRule ^packers-and-movers-in-nagaruntari(\.php)?/?$ /packers-and-movers-in-nagar-untari [R=301,L]
RewriteRule ^packers-and-movers-in-husainabad(\.php)?/?$ /packers-and-movers-in-hussainabad [R=301,L]
RewriteRule ^packers-and-movers-in-garhwa(\.php)?/?$ /packers-and-movers-in-gharwha [R=301,L]
RewriteRule ^packers-and-movers-in-seraikela-kharsawan(\.php)?/?$ /packers-and-movers-in-saraikela-kharsawan [R=301,L]
RewriteRule ^services(\.php)?/?$ / [R=301,L]
RewriteRule ^(jharkhand|packers-and-movers-in-jharkhand)(\.php)?/?$ / [R=301,L]

# 301 Permanent Redirect to strip trailing slash from non-service URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(residential-shifting|business-shifting|vehicle-shifting|packing-and-unpacking|loading-and-unloading-services|warehouse-service|international-service|domestics-service|insurance-service)/
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 301 Permanent Redirect to prevent direct access to /pages/ directory in browser URL
RewriteRule ^pages/(.*)$ /$1 [R=301,L]

# Allow direct access to actual existing files, assets and images
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all incoming page requests through router.php
RewriteRule ^ router.php [L,QSA]

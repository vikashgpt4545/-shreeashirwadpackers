    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much do packers and movers charge in Ranchi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Local shifting within Ranchi typically costs Rs 4,000 to Rs 18,000 depending on home size and distance, while moves from Ranchi to metro cities range from Rs 14,000 to Rs 55,000. Surya Packers gives a fixed written quote after a free survey, so there are no surprises on moving day."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide packing material?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, all packing material is included free in the quoted price – corrugated boxes, bubble wrap, foam sheets, stretch film, waterproof lamination for mattresses and wooden crating for TVs, glass and marble items."
          }
        },
        {
          "@type": "Question",
          "name": "Which areas of Ranchi do you cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We cover all of Ranchi including Booty, Bariatu, Kanke, Lalpur, Doranda, Harmu, Hatia, Morabadi, Kokar and Ratu Road, plus intercity moves to any city in India."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book a move with Surya Packers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Call or WhatsApp 94301 10339, or submit the quote form on this page. We do a quick survey (phone, video or in person), share a written estimate within 30 minutes, and lock your moving date."
          }
        },
        {
          "@type": "Question",
          "name": "Can you transport my car or bike from Ranchi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We transport cars on closed or open carriers and bikes with foam wrap and optional wooden crating. Photo condition reports are taken at pickup and delivery on every vehicle move."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer part-load shipping to other cities?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Part-load (shared truck) options are available on all major routes from Ranchi, which cuts cost by 30–50% for smaller moves like 1RK or 1BHK."
          }
        },
        {
          "@type": "Question",
          "name": "Is there an office I can visit in Ranchi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes – NH-33, Ranchi–Patna Rd, near Choudhary Petrol Pump, Krishna Pura, Booty, Dumardaga, Ranchi 834012. Open 8 AM to 9 PM, all 7 days."
          }
        }
      ]
